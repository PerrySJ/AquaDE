[Icon Theme]
Name=AquaDE
Comment=Sea-green folders, plastic sheets, shells and brass: the icons of the AquaDE tank
Inherits=Adwaita,AdwaitaLegacy,hicolor
Example=folder
Directories=16x16/places,16x16/mimetypes,16x16/devices,scalable/places,scalable/mimetypes,scalable/devices

[16x16/places]
Context=Places
Size=16
MinSize=8
MaxSize=31
Type=Scalable

[16x16/mimetypes]
Context=MimeTypes
Size=16
MinSize=8
MaxSize=31
Type=Scalable

[16x16/devices]
Context=Devices
Size=16
MinSize=8
MaxSize=31
Type=Scalable

[scalable/places]
Context=Places
Size=64
MinSize=32
MaxSize=512
Type=Scalable

[scalable/mimetypes]
Context=MimeTypes
Size=64
MinSize=32
MaxSize=512
Type=Scalable

[scalable/devices]
Context=Devices
Size=64
MinSize=32
MaxSize=512
Type=Scalable
