# AquaDE's standard programs: the default program for each kind of file in
# a AquaDE session (XDG_CURRENT_DESKTOP=AquaDE), and what the drawer's four
# things open -- the terminal, the browser (x-scheme-handler/https), the
# file manager (inode/directory) and the text editor (text/plain).
#
# A list for each: the first one installed is used. It is looked for after
# your own choices, in the freedesktop order: ~/.config/desk-mimeapps.list
# (in AquaDE only), then ~/.config/mimeapps.list -- which Shell Settings'
# Default programs (xfce4-mime-settings) and other desktops write -- and the
# same two in the system's folders. shell.conf can also name the drawer's
# things (app.editor = pluma.desktop, and so on).
#
# The set is the classic GTK programs of Xfce and MATE: a menu bar, plain
# tools and the document, the kind of window the desk's paper is cut for,
# and small enough for a slow machine. KDE's programs come after them, and
# GNOME's, whose header bars are a frame of their own, after those. Caja
# goes by the entry it gives for folders (caja-folder-handler): its plain
# one would make it MATE's desktop as well, icons over the background.
# The ones named <name>_<name> are Ubuntu's snaps.

[Default Applications]
text/plain=org.xfce.mousepad.desktop;mousepad.desktop;pluma.desktop;featherpad.desktop;org.kde.kwrite.desktop;org.kde.kate.desktop;org.gnome.gedit.desktop;org.gnome.TextEditor.desktop;
text/markdown=org.xfce.mousepad.desktop;mousepad.desktop;pluma.desktop;featherpad.desktop;org.kde.kwrite.desktop;org.kde.kate.desktop;org.gnome.gedit.desktop;org.gnome.TextEditor.desktop;
inode/directory=thunar.desktop;caja-folder-handler.desktop;pcmanfm.desktop;nemo.desktop;pcmanfm-qt.desktop;org.kde.dolphin.desktop;org.gnome.Nautilus.desktop;
x-scheme-handler/http=firefox-esr.desktop;firefox.desktop;org.mozilla.firefox.desktop;firefox_firefox.desktop;chromium.desktop;chromium_chromium.desktop;org.kde.falkon.desktop;
